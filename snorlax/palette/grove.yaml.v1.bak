# Grove — living palette source of truth (annotated)
# Single source that all tools (kitty, OMP, neovim, btop, sketchybar, etc)
# derive their themes from via the generator (Phase 4).
#
# Companion: canonical base16 YAMLs live in ~/base16-grove-scheme/ (published
# repo) — grove.yaml (dark, this file's hexes), grove-light.yaml, grove-mist.yaml,
# grove-nocturne.yaml. This SOT adds phase markers / status tags / consumer
# annotations the repo version deliberately omits.
#
# Phase markers indicate when each slot is ACTIVELY consumed:
#   [P1] = currently consumed in Phase 1 tools (kitty, OMP, fastfetch)
#   [P2] = queued for Phase 2 (sketchybar, jankyborders, aerospace-adjacent)
#   [P3] = queued for Phase 3 (neovim, lazygit, lazydocker, zen browser)
#   [P4] = generator, widgets, custom builds
#   [-]  = reserved, no active consumer yet
#
# Status tags:
#   (C) committed — hex is final, do not change without cascading
#   (T) tentative — may tune during live testing
#
# Consumers column tracks which tools currently use each slot.

name: grove
system: base16
version: 1

# ============================================================
# DARK MODE (current, default)
# ============================================================
dark:
  # Surfaces (monochrome ramp, cool-teal family)
  base00: "#13242a"  # [P1] (C)  darkest bg — kitty, omp pill-bg, fastfetch, nvim bg
  base01: "#1b2f34"  # [P1] (C)  lighter bg — kitty inactive tab, omp optional pill-bg variant
  base02: "#263d42"  # [P1] (C)  selection bg — kitty selection, omp pill-fg, nvim visual
  base03: "#5a7880"  # [P1] (C)  muted — kitty bright-black, omp comments, nvim comments
  base04: "#8098a0"  # [P1] (C)  dark fg — designed, cool-neutral
  base05: "#e4ebe4"  # [P1] (C)  default fg — kitty fg, omp text, nvim fg (warm cream)
  base06: "#eef4ec"  # [P2] (T)  light fg — reserved for emphasis/light-surface roles
  base07: "#f6faf4"  # [P2] (T)  lightest — reserved for bright-fg role, light-mode bg

  # Accents (tier 2, functional)
  base08: "#e878a8"  # [P1] (C)  HERO / red slot — sakura-rose, diff deletions, errors, active state
  base09: "#e89878"  # [P1] (C)  orange — peach, numbers, constants
  base0A: "#e8c888"  # [P1] (C)  yellow — cream-gold, types, warnings
  base0B: "#78b098"  # [P1] (C)  green — mint-sage, strings, additions
  base0C: "#58b0b8"  # [P1] (C)  cyan — saturated teal, secondary accent, labels, links
  base0D: "#5090b0"  # [P1] (C)  blue — mid-blue water tones, functions
  base0E: "#a890c0"  # [P1] (C)  purple — dusty lavender, keywords, modifiers
  base0F: "#78786a"  # [P3] (T)  brown — olive bridge, deprecated, rare

# ============================================================
# OTHER VARIANTS (not annotated here — canonical hexes live in the repo)
# ============================================================
# Full palette family published at ~/base16-grove-scheme/:
#   - grove-light.yaml     (warm cream base, Solarized-inspired daytime)
#   - grove-mist.yaml      (cool-pale alt to light, bright environments)
#   - grove-nocturne.yaml  (high-contrast night variant)
#
# Personal config currently uses dark only. When a variant gets activated
# for live consumption, copy its 16 hexes here and annotate with the same
# phase-marker / status-tag / consumer schema as the dark block above.

# ============================================================
# SEMANTIC ALIASES (optional, for tools that prefer named refs)
# These resolve to base0X values above.
# ============================================================
aliases:
  bg: base00
  bg_alt: base01
  selection: base02
  muted: base03
  fg_dim: base04
  fg: base05
  fg_bright: base06
  fg_lightest: base07

  hero: base08
  peach: base09
  gold: base0A
  mint: base0B
  teal: base0C
  blue: base0D
  lavender: base0E
  olive: base0F

# ============================================================
# EXTRAS (off-palette hexes used in current configs — reference
# for future non-base16 expansion. NOT canonical base16 slots.)
# ============================================================
extras:
  # Cool teal/blue family (extensions of base02/base03/base0C/base0D)
  hover_bg:    "#2a3f46"  # sketchybar hover bg — darker than base02 selection
  teal_dim:    "#4a8c92"  # sketchybar GROVE_TEAL_DIM, yazi active tab — between base03 muted and base0C teal
  blue_dim:    "#5e8d9e"  # yazi inactive tab — cooler shade between base03 and base0D
  blue_bright: "#6ba8c7"  # yazi status bar — brighter than base0D water-blue

  # Lavender family (extensions of base0E)
  lavender_dim: "#8b7d9e"  # yazi mode indicators — desaturated base0E
  periwinkle:   "#7887ba"  # yazi media/creative file types (46 occurrences) — bluer base0E variant

# ============================================================
# DESIGN NOTES (reference — do not rely on programmatically)
# ============================================================
# Three-family structure:
#   Cool family (6):  base00, base01, base02, base0B, base0C, base0D
#   Warm secondary (3): base09, base0A, base0F
#   Hero + purple (2):  base08, base0E
#
# HERO (base08 sakura-rose) appears surgically:
#   - Active state (tab, border, URL, bell)
#   - Errors, diff deletions, git rename, diverged branch
#   - NOT on cursor, NOT on ambient borders, NOT on body text
#
# Secondary accent (base0C saturated teal) appears on:
#   - Labels (fastfetch, btop, sketchybar module labels)
#   - Operators (syntax highlighting)
#   - Link color
